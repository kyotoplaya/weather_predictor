    fap_icon="predictor.png",  # 10x10 1-bit PNG
    # fap_description="A simple app",
    # fap_author="J. Doe",
    # fap_weburl="https://github.com/user/predictor",
    fap_icon_assets="images",  # Image assets to compile for this application
)
